{
  /* Test files only. Identical to the app config except that Node types are
     available — the cold-start suite runs a real loopback HTTP server.
     Deliberately separate so `npm run typecheck`, which gates the Vercel
     build, never lets Node globals into browser code. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": []
}
