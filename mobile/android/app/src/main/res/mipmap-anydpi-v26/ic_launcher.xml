<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The launcher applies its own mask —
     circle, squircle, rounded square — to these two layers, so the crest in
     the foreground is scaled into the central 66dp safe zone and survives
     every mask shape. API 24-25 fall back to mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
